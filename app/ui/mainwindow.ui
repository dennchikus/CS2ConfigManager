}
QCheckBox {
    padding: 6px 10px;
    font-size: 13px;
    spacing: 6px;
    color: #e4e4e7;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #52525b;
    background: #18181b;
}
QCheckBox::indicator:checked {
